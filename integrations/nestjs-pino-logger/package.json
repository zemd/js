{
  "name": "@zemd/nestjs-pino-logger",
  "version": "2.0.0",
  "description": "NestJS logger powered by Pino",
  "keywords": [
    "logger",
    "nestjs",
    "pino"
  ],
  "homepage": "https://github.com/zemd/js/tree/main/integrations/nestjs-pino-logger",
  "bugs": {
    "url": "https://github.com/zemd/js/issues"
  },
  "license": "BlueOak-1.0.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemd/js.git",
    "directory": "integrations/nestjs-pino-logger"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./pino-pretty-transport": {
      "types": "./dist/pino-pretty-transport.d.mts",
      "import": "./dist/pino-pretty-transport.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "test-bench": "node ./benchmarks/logger.bench.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint-publish": "publint",
    "pretest": "pnpm run build",
    "pretest-coverage": "pnpm run build",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage \"--test-coverage-include=dist/**/*.mjs\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage.lcov",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clean-stack": "6.0.0",
    "ms": "2.1.3"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.28",
    "@types/ms": "2.1.0",
    "@types/node": "catalog:",
    "@zemd/testing": "workspace:*",
    "@zemd/tsconfig": "workspace:*",
    "fast-check": "catalog:",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
