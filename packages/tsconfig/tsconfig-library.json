{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Bundled library tsconfig",
  "extends": "./tsconfig-base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "sourceMap": false,
    "declarationMap": false
  }
}
