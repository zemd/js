{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@zemd/color",
  "extends": "@zemd/tsconfig/tsconfig-library.json",
  "compilerOptions": {
    // Exported Zod schemas require TypeScript to infer their declarations.
    "isolatedDeclarations": false,
    "types": ["node"]
  },
  "include": ["benchmarks/**/*.ts", "src/**/*.ts", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist"]
}
