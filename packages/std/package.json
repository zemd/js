{
  "name": "@zemd/std-modules",
  "version": "0.1.1",
  "description": "Standalone ECMAScript Modules for diverse use cases",
  "keywords": [
    "modules",
    "std",
    "utilities"
  ],
  "homepage": "https://github.com/zemd/js/tree/main/packages/std",
  "bugs": {
    "url": "https://github.com/zemd/js/issues"
  },
  "license": "BlueOak-1.0.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemd/js.git",
    "directory": "packages/std"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./dom": {
      "types": "./dist/dom.d.mts",
      "import": "./dist/dom.mjs"
    },
    "./env": {
      "types": "./dist/env.d.mts",
      "import": "./dist/env.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs"
    },
    "./invariant": {
      "types": "./dist/invariant.d.mts",
      "import": "./dist/invariant.mjs"
    },
    "./math": {
      "types": "./dist/math.d.mts",
      "import": "./dist/math.mjs"
    },
    "./objects": {
      "types": "./dist/objects.d.mts",
      "import": "./dist/objects.mjs"
    },
    "./promises": {
      "types": "./dist/promises.d.mts",
      "import": "./dist/promises.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "node --test",
    "test-browser": "pnpm run build && playwright test",
    "test-coverage": "node --test --experimental-test-coverage \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-exclude=src/**/*.test.ts\" \"--test-coverage-exclude=src/**/*.spec.ts\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage.lcov",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zemd/testing": "workspace:*",
    "@zemd/tsconfig": "workspace:*",
    "fast-check": "catalog:",
    "playwright": "1.62.1",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
