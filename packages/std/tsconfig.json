{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@zemd/std-modules",
  "extends": "@zemd/tsconfig/tsconfig-library.json",
  "compilerOptions": {
    "types": ["node"],
    // `@zemd/properties` is private and unpublished, so it is mapped instead of depended on.
    "paths": {
      "@zemd/properties/*": ["../../internal/properties/src/*.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
