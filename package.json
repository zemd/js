{
  "name": "@zemd/js",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "scripts": {
    "test-bench": "turbo run test-bench --filter=@zemd/color --filter=@zemd/nestjs-pino-logger --filter=@zemd/std-modules",
    "build": "turbo run build",
    "test": "turbo run test",
    "test-browser": "turbo run test-browser",
    "test-browser-setup": "pnpm --filter @zemd/std-modules exec playwright install --with-deps chromium",
    "test-coverage": "turbo run test-coverage",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix --ignore-pattern=.github/scripts",
    "lint-check": "oxlint --type-aware --deny-warnings --ignore-pattern=.github/scripts",
    "lint-actions": "zizmor --strict-collection --collect=default --persona=pedantic .",
    "lint-publish": "turbo run lint-publish",
    "pre-commit": "./.githooks/pre-commit",
    "pre-push": "./.githooks/pre-push",
    "git-hooks-install": "./.githooks/install.sh",
    "release-change": "pnpm change",
    "release-status": "pnpm change status",
    "prepare": "pnpm run git-hooks-install"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "turbo": "2.11.7"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
