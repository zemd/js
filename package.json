{
  "name": "@zemd/js",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "oss@zemd.dev",
    "url": "https://zemd.dev"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && pnpm run test-release",
    "test-release": "node --test .github/scripts/release-pr-body.test.mjs .github/scripts/release-workflow.test.mjs",
    "test-browser": "turbo run test-browser",
    "test-browser-setup": "pnpm --filter @zemd/std-modules exec playwright install --with-deps chromium",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "lint": "oxlint --type-aware --fix",
    "lint-check": "oxlint --type-aware --deny-warnings",
    "lint-publish": "pnpm -r exec publint",
    "release-change": "pnpm change",
    "release-status": "pnpm change status",
    "release-bump": "pnpm version -r",
    "release-publish": "pnpm publish -r --access public",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.22",
    "turbo": "2.10.8"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
